# Keep this file value-free. Copy the names into your trusted process manager.
WECHAT_CS_DATA_ROOT=/absolute/path/to/your-export
WECHAT_CS_STATE_ROOT=/absolute/path/to/wechat-cs-parser/.wechat-cs
WECHAT_CS_BIND=127.0.0.1
WECHAT_CS_PORT=8765
WECHAT_CS_TOKEN=replace-with-a-long-random-service-token
WECHAT_CS_HMAC_SECRET=replace-with-a-different-long-random-secret
WECHAT_CS_ACCOUNT_ID=current-export

# Kimi Open Platform, not Kimi Coding Plan.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

# Optional read-only knowledge source registry.
WECHAT_CS_KNOWLEDGE_CONFIG=config/knowledge_sources.json
